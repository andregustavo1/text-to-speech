<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_EToSpeech"
  targetNamespace="http://andregustavo1/text-to-speech/bpmn">

  <bpmn:collaboration id="Collaboration_EToSpeech">
    <bpmn:participant id="Participant_FluxoPrincipal" name="E-To-Speech (Fluxo Colaborativo Principal)" processRef="Processo_EToSpeech" />
  </bpmn:collaboration>

  <bpmn:process id="Processo_EToSpeech" name="Fluxos do sistema E-To-Speech" isExecutable="false">
    <bpmn:documentation>Modelo inferido da branch entrega2809. O código observado implementa autenticação, importação, gestão e visualização de PDFs com Supabase Auth e Storage. A conversão de texto em voz não está explicitamente implementada no código analisado.</bpmn:documentation>

    <bpmn:laneSet id="LaneSet_Principal">
      <bpmn:lane id="Lane_Usuario" name="Usuário">
        <bpmn:flowNodeRef>Start_AcessoInicial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_AcessaApp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_InformaCredenciais</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_PreencheCadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_ConfirmaEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_InformaEmailReset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_DefineNovaSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_AbreMenuBiblioteca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_SelecionaArquivoPDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_SelecionaPDFAbrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_InformaNovoNome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_ConfirmaExclusao</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_FechaBibliotecaMenu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FimFluxo</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Frontend" name="Frontend React (App, ProtectedRoute, Login, Lib, Upload, Menu, PdfViewer)">
        <bpmn:flowNodeRef>Task_FE_VerificaRotaProtegida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SessaoAtiva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_RedirecionaLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ExibeTelaLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AcaoTelaLogin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CredenciaisValidas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ErroCredenciaisInvalidas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_RedirecionaDestinoSeguro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SenhasConferem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ErroConfirmacaoSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ResetSenhaOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ErroResetSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeAutenticado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_LiberaAplicacaoPrincipal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OperacaoBiblioteca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ArquivoSelecionado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ErroArquivoNaoSelecionado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_NormalizaNomeArquivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_UploadOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ErroUploadOuStorage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_AtualizaBibliotecaUpload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_URLAssinadaOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ErroStorageAbrir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_VisualizaPDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MoveOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ErroStorageRenomear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_AtualizaBibliotecaRename</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RemoveOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_ErroStorageExcluir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_AtualizaBibliotecaDelete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FE_RetornaAplicacao</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SupabaseAuth" name="Supabase Auth">
        <bpmn:flowNodeRef>Task_Auth_ConsultaUsuarioAtual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Auth_LoginComSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Auth_CadastroSignUp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Auth_SolicitaRecuperacaoSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Auth_AtualizaSenha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Auth_ObtemUsuarioUpload</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_SupabaseStorage" name="Supabase Storage (bucket pdfs por user.id)">
        <bpmn:flowNodeRef>Task_Storage_UploadPDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Storage_ListaPDFsUsuario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Storage_GeraURLAssinada3600</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Storage_MoveRenomear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Storage_RemoveExcluir</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Email" name="Serviço de E-mail">
        <bpmn:flowNodeRef>Task_Email_EnviaConfirmacaoCadastro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Email_EnviaLinkRecuperacao</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_AcessoInicial" name="Acesso inicial" />
    <bpmn:task id="Task_User_AcessaApp" name="Usuário acessa /" />
    <bpmn:task id="Task_FE_VerificaRotaProtegida" name="ProtectedRoute verifica sessão" />
    <bpmn:task id="Task_Auth_ConsultaUsuarioAtual" name="Auth.getUser()" />
    <bpmn:exclusiveGateway id="Gateway_SessaoAtiva" name="Sessão ativa?" />

    <bpmn:task id="Task_FE_RedirecionaLogin" name="Redirecionar para /login" />
    <bpmn:task id="Task_FE_ExibeTelaLogin" name="Exibir tela de login" />
    <bpmn:exclusiveGateway id="Gateway_AcaoTelaLogin" name="Ação do usuário" />

    <bpmn:task id="Task_User_InformaCredenciais" name="Informar e-mail e senha" />
    <bpmn:task id="Task_Auth_LoginComSenha" name="signInWithPassword" />
    <bpmn:exclusiveGateway id="Gateway_CredenciaisValidas" name="Credenciais válidas?" />
    <bpmn:task id="Task_FE_ErroCredenciaisInvalidas" name="Exibir erro credenciais inválidas" />
    <bpmn:task id="Task_FE_RedirecionaDestinoSeguro" name="Redirecionar para next seguro ou home" />

    <bpmn:task id="Task_User_PreencheCadastro" name="Cadastro + confirmação de senha" />
    <bpmn:exclusiveGateway id="Gateway_SenhasConferem" name="Senhas conferem?" />
    <bpmn:task id="Task_FE_ErroConfirmacaoSenha" name="Exibir erro de confirmação" />
    <bpmn:task id="Task_Auth_CadastroSignUp" name="signUp" />
    <bpmn:task id="Task_Email_EnviaConfirmacaoCadastro" name="Enviar e-mail de confirmação" />
    <bpmn:task id="Task_User_ConfirmaEmail" name="Confirmar e-mail cadastrado" />

    <bpmn:task id="Task_User_InformaEmailReset" name="Informar e-mail para recuperação" />
    <bpmn:task id="Task_Auth_SolicitaRecuperacaoSenha" name="resetPasswordForEmail" />
    <bpmn:task id="Task_Email_EnviaLinkRecuperacao" name="Enviar link de redefinição" />
    <bpmn:task id="Task_User_DefineNovaSenha" name="Abrir link e definir nova senha" />
    <bpmn:task id="Task_Auth_AtualizaSenha" name="updateUser(password)" />
    <bpmn:exclusiveGateway id="Gateway_ResetSenhaOk" name="Senha atualizada?" />
    <bpmn:task id="Task_FE_ErroResetSenha" name="Exibir erro ao atualizar senha" />

    <bpmn:exclusiveGateway id="Gateway_MergeAutenticado" name="Fluxo autenticado" />
    <bpmn:task id="Task_FE_LiberaAplicacaoPrincipal" name="Liberar App principal" />
    <bpmn:task id="Task_User_AbreMenuBiblioteca" name="Abrir menu lateral / biblioteca" />
    <bpmn:exclusiveGateway id="Gateway_OperacaoBiblioteca" name="Operação da biblioteca" />

    <bpmn:task id="Task_User_SelecionaArquivoPDF" name="Selecionar arquivo PDF" />
    <bpmn:exclusiveGateway id="Gateway_ArquivoSelecionado" name="Arquivo selecionado?" />
    <bpmn:task id="Task_FE_ErroArquivoNaoSelecionado" name="Exibir erro: arquivo não selecionado" />
    <bpmn:task id="Task_Auth_ObtemUsuarioUpload" name="Obter usuário autenticado" />
    <bpmn:task id="Task_FE_NormalizaNomeArquivo" name="Normalizar nome (acentos/especiais/espaços/lowercase)" />
    <bpmn:task id="Task_Storage_UploadPDF" name="Upload para pdfs/${user.id}/${nomeArquivo}" />
    <bpmn:exclusiveGateway id="Gateway_UploadOk" name="Upload/Storage OK?" />
    <bpmn:task id="Task_FE_ErroUploadOuStorage" name="Exibir erro de upload/storage" />
    <bpmn:task id="Task_FE_AtualizaBibliotecaUpload" name="Atualizar biblioteca após upload" />

    <bpmn:task id="Task_Storage_ListaPDFsUsuario" name="Listar PDFs do usuário" />
    <bpmn:task id="Task_User_SelecionaPDFAbrir" name="Selecionar PDF para abrir" />
    <bpmn:task id="Task_Storage_GeraURLAssinada3600" name="createSignedUrl(3600)" />
    <bpmn:exclusiveGateway id="Gateway_URLAssinadaOk" name="URL assinada gerada?" />
    <bpmn:task id="Task_FE_ErroStorageAbrir" name="Exibir erro de operação de storage" />
    <bpmn:task id="Task_FE_VisualizaPDF" name="Visualizar PDF no PdfViewer" />

    <bpmn:task id="Task_User_InformaNovoNome" name="Informar novo nome do PDF" />
    <bpmn:task id="Task_Storage_MoveRenomear" name="Renomear com move" />
    <bpmn:exclusiveGateway id="Gateway_MoveOk" name="Renomear OK?" />
    <bpmn:task id="Task_FE_ErroStorageRenomear" name="Exibir erro ao renomear" />
    <bpmn:task id="Task_FE_AtualizaBibliotecaRename" name="Atualizar biblioteca após renomear" />

    <bpmn:task id="Task_User_ConfirmaExclusao" name="Confirmar exclusão" />
    <bpmn:task id="Task_Storage_RemoveExcluir" name="Excluir com remove" />
    <bpmn:exclusiveGateway id="Gateway_RemoveOk" name="Excluir OK?" />
    <bpmn:task id="Task_FE_ErroStorageExcluir" name="Exibir erro ao excluir" />
    <bpmn:task id="Task_FE_AtualizaBibliotecaDelete" name="Atualizar biblioteca após excluir" />

    <bpmn:task id="Task_User_FechaBibliotecaMenu" name="Fechar biblioteca/menu" />
    <bpmn:task id="Task_FE_RetornaAplicacao" name="Retornar à aplicação" />
    <bpmn:endEvent id="End_FimFluxo" name="Fim da navegação" />

    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_AcessoInicial" targetRef="Task_User_AcessaApp" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_User_AcessaApp" targetRef="Task_FE_VerificaRotaProtegida" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_FE_VerificaRotaProtegida" targetRef="Task_Auth_ConsultaUsuarioAtual" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Auth_ConsultaUsuarioAtual" targetRef="Gateway_SessaoAtiva" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_SessaoAtiva" targetRef="Gateway_MergeAutenticado" name="Sim" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_SessaoAtiva" targetRef="Task_FE_RedirecionaLogin" name="Não" />

    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_FE_RedirecionaLogin" targetRef="Task_FE_ExibeTelaLogin" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_FE_ExibeTelaLogin" targetRef="Gateway_AcaoTelaLogin" />

    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_AcaoTelaLogin" targetRef="Task_User_InformaCredenciais" name="Login" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_User_InformaCredenciais" targetRef="Task_Auth_LoginComSenha" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Auth_LoginComSenha" targetRef="Gateway_CredenciaisValidas" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_CredenciaisValidas" targetRef="Task_FE_RedirecionaDestinoSeguro" name="Sim" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_CredenciaisValidas" targetRef="Task_FE_ErroCredenciaisInvalidas" name="Não" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_FE_ErroCredenciaisInvalidas" targetRef="Task_User_InformaCredenciais" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_FE_RedirecionaDestinoSeguro" targetRef="Gateway_MergeAutenticado" />

    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_AcaoTelaLogin" targetRef="Task_User_PreencheCadastro" name="Cadastro" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_User_PreencheCadastro" targetRef="Gateway_SenhasConferem" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_SenhasConferem" targetRef="Task_FE_ErroConfirmacaoSenha" name="Não" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_FE_ErroConfirmacaoSenha" targetRef="Task_User_PreencheCadastro" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_SenhasConferem" targetRef="Task_Auth_CadastroSignUp" name="Sim" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_Auth_CadastroSignUp" targetRef="Task_Email_EnviaConfirmacaoCadastro" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Email_EnviaConfirmacaoCadastro" targetRef="Task_User_ConfirmaEmail" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_User_ConfirmaEmail" targetRef="Task_FE_ExibeTelaLogin" />

    <bpmn:sequenceFlow id="Flow_24" sourceRef="Gateway_AcaoTelaLogin" targetRef="Task_User_InformaEmailReset" name="Recuperar senha" />
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Task_User_InformaEmailReset" targetRef="Task_Auth_SolicitaRecuperacaoSenha" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Auth_SolicitaRecuperacaoSenha" targetRef="Task_Email_EnviaLinkRecuperacao" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_Email_EnviaLinkRecuperacao" targetRef="Task_User_DefineNovaSenha" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_User_DefineNovaSenha" targetRef="Task_Auth_AtualizaSenha" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_Auth_AtualizaSenha" targetRef="Gateway_ResetSenhaOk" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Gateway_ResetSenhaOk" targetRef="Gateway_MergeAutenticado" name="Sim" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_ResetSenhaOk" targetRef="Task_FE_ErroResetSenha" name="Não" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_FE_ErroResetSenha" targetRef="Task_User_DefineNovaSenha" />

    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_MergeAutenticado" targetRef="Task_FE_LiberaAplicacaoPrincipal" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_FE_LiberaAplicacaoPrincipal" targetRef="Task_User_AbreMenuBiblioteca" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_User_AbreMenuBiblioteca" targetRef="Gateway_OperacaoBiblioteca" />

    <bpmn:sequenceFlow id="Flow_36" sourceRef="Gateway_OperacaoBiblioteca" targetRef="Task_User_SelecionaArquivoPDF" name="Upload" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_User_SelecionaArquivoPDF" targetRef="Gateway_ArquivoSelecionado" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Gateway_ArquivoSelecionado" targetRef="Task_FE_ErroArquivoNaoSelecionado" name="Não" />
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_FE_ErroArquivoNaoSelecionado" targetRef="Gateway_OperacaoBiblioteca" />
    <bpmn:sequenceFlow id="Flow_40" sourceRef="Gateway_ArquivoSelecionado" targetRef="Task_Auth_ObtemUsuarioUpload" name="Sim" />
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Task_Auth_ObtemUsuarioUpload" targetRef="Task_FE_NormalizaNomeArquivo" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Task_FE_NormalizaNomeArquivo" targetRef="Task_Storage_UploadPDF" />
    <bpmn:sequenceFlow id="Flow_43" sourceRef="Task_Storage_UploadPDF" targetRef="Gateway_UploadOk" />
    <bpmn:sequenceFlow id="Flow_44" sourceRef="Gateway_UploadOk" targetRef="Task_FE_ErroUploadOuStorage" name="Não" />
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Task_FE_ErroUploadOuStorage" targetRef="Gateway_OperacaoBiblioteca" />
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Gateway_UploadOk" targetRef="Task_FE_AtualizaBibliotecaUpload" name="Sim" />
    <bpmn:sequenceFlow id="Flow_47" sourceRef="Task_FE_AtualizaBibliotecaUpload" targetRef="Gateway_OperacaoBiblioteca" />

    <bpmn:sequenceFlow id="Flow_48" sourceRef="Gateway_OperacaoBiblioteca" targetRef="Task_Storage_ListaPDFsUsuario" name="Abrir" />
    <bpmn:sequenceFlow id="Flow_49" sourceRef="Task_Storage_ListaPDFsUsuario" targetRef="Task_User_SelecionaPDFAbrir" />
    <bpmn:sequenceFlow id="Flow_50" sourceRef="Task_User_SelecionaPDFAbrir" targetRef="Task_Storage_GeraURLAssinada3600" />
    <bpmn:sequenceFlow id="Flow_51" sourceRef="Task_Storage_GeraURLAssinada3600" targetRef="Gateway_URLAssinadaOk" />
    <bpmn:sequenceFlow id="Flow_52" sourceRef="Gateway_URLAssinadaOk" targetRef="Task_FE_VisualizaPDF" name="Sim" />
    <bpmn:sequenceFlow id="Flow_53" sourceRef="Gateway_URLAssinadaOk" targetRef="Task_FE_ErroStorageAbrir" name="Não" />
    <bpmn:sequenceFlow id="Flow_54" sourceRef="Task_FE_ErroStorageAbrir" targetRef="Gateway_OperacaoBiblioteca" />
    <bpmn:sequenceFlow id="Flow_55" sourceRef="Task_FE_VisualizaPDF" targetRef="Gateway_OperacaoBiblioteca" />

    <bpmn:sequenceFlow id="Flow_56" sourceRef="Gateway_OperacaoBiblioteca" targetRef="Task_User_InformaNovoNome" name="Renomear" />
    <bpmn:sequenceFlow id="Flow_57" sourceRef="Task_User_InformaNovoNome" targetRef="Task_Storage_MoveRenomear" />
    <bpmn:sequenceFlow id="Flow_58" sourceRef="Task_Storage_MoveRenomear" targetRef="Gateway_MoveOk" />
    <bpmn:sequenceFlow id="Flow_59" sourceRef="Gateway_MoveOk" targetRef="Task_FE_ErroStorageRenomear" name="Não" />
    <bpmn:sequenceFlow id="Flow_60" sourceRef="Task_FE_ErroStorageRenomear" targetRef="Gateway_OperacaoBiblioteca" />
    <bpmn:sequenceFlow id="Flow_61" sourceRef="Gateway_MoveOk" targetRef="Task_FE_AtualizaBibliotecaRename" name="Sim" />
    <bpmn:sequenceFlow id="Flow_62" sourceRef="Task_FE_AtualizaBibliotecaRename" targetRef="Gateway_OperacaoBiblioteca" />

    <bpmn:sequenceFlow id="Flow_63" sourceRef="Gateway_OperacaoBiblioteca" targetRef="Task_User_ConfirmaExclusao" name="Excluir" />
    <bpmn:sequenceFlow id="Flow_64" sourceRef="Task_User_ConfirmaExclusao" targetRef="Task_Storage_RemoveExcluir" />
    <bpmn:sequenceFlow id="Flow_65" sourceRef="Task_Storage_RemoveExcluir" targetRef="Gateway_RemoveOk" />
    <bpmn:sequenceFlow id="Flow_66" sourceRef="Gateway_RemoveOk" targetRef="Task_FE_ErroStorageExcluir" name="Não" />
    <bpmn:sequenceFlow id="Flow_67" sourceRef="Task_FE_ErroStorageExcluir" targetRef="Gateway_OperacaoBiblioteca" />
    <bpmn:sequenceFlow id="Flow_68" sourceRef="Gateway_RemoveOk" targetRef="Task_FE_AtualizaBibliotecaDelete" name="Sim" />
    <bpmn:sequenceFlow id="Flow_69" sourceRef="Task_FE_AtualizaBibliotecaDelete" targetRef="Gateway_OperacaoBiblioteca" />

    <bpmn:sequenceFlow id="Flow_70" sourceRef="Gateway_OperacaoBiblioteca" targetRef="Task_User_FechaBibliotecaMenu" name="Fechar/retornar" />
    <bpmn:sequenceFlow id="Flow_71" sourceRef="Task_User_FechaBibliotecaMenu" targetRef="Task_FE_RetornaAplicacao" />
    <bpmn:sequenceFlow id="Flow_72" sourceRef="Task_FE_RetornaAplicacao" targetRef="End_FimFluxo" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_EToSpeech">
    <bpmndi:BPMNPlane id="BPMNPlane_EToSpeech" bpmnElement="Collaboration_EToSpeech">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_FluxoPrincipal" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="5200" height="900" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Usuario" bpmnElement="Lane_Usuario" isHorizontal="true"><dc:Bounds x="110" y="120" width="5170" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Frontend" bpmnElement="Lane_Frontend" isHorizontal="true"><dc:Bounds x="110" y="260" width="5170" height="180" /></bpmndi:BPMNShape>
